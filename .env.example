# Server-only. Use a libSQL-compatible Turso database (libsql://...), not turso://.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required only when creating the first production administrator (12+ characters).
SPOKEMON_ADMIN_LOGIN=admin
SPOKEMON_ADMIN_PASSWORD=
# Optional local development database when Turso variables are absent.
# SPOKEMON_DB=server/data/spokemon.sqlite
